{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "GraphDocument",
  "type": "object",
  "properties": {
    "format_version": {
      "type": "string"
    },
    "required_providers": {
      "type": "object",
      "additionalProperties": {
        "$ref": "#/$defs/ProviderRequirement"
      },
      "default": {}
    },
    "provider_configs": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/ProviderConfig"
      },
      "default": []
    },
    "resources": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/ResourceSpec"
      },
      "default": []
    },
    "data_sources": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/DataSourceSpec"
      },
      "default": []
    },
    "outputs": {
      "type": "object",
      "additionalProperties": {
        "$ref": "#/$defs/OutputSpec"
      },
      "default": {}
    },
    "moves": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/MoveSpec"
      },
      "default": []
    },
    "imports": {
      "description": "Existing objects to adopt into managed resources on the next apply, lowered to\n`import` blocks so a whole account can be taken over in one plan.",
      "type": "array",
      "items": {
        "$ref": "#/$defs/ImportSpec"
      }
    }
  },
  "additionalProperties": false,
  "required": [
    "format_version"
  ],
  "$defs": {
    "ProviderRequirement": {
      "type": "object",
      "properties": {
        "source": {
          "type": "string"
        },
        "version": {
          "type": "string"
        }
      },
      "additionalProperties": false,
      "required": [
        "source",
        "version"
      ]
    },
    "ProviderConfig": {
      "type": "object",
      "properties": {
        "provider": {
          "type": "string"
        },
        "alias": {
          "type": [
            "string",
            "null"
          ]
        },
        "arguments": {
          "type": "object",
          "additionalProperties": {
            "$ref": "#/$defs/Expr"
          },
          "default": {}
        }
      },
      "additionalProperties": false,
      "required": [
        "provider"
      ]
    },
    "Expr": {
      "oneOf": [
        {
          "type": "object",
          "properties": {
            "value": true,
            "kind": {
              "type": "string",
              "const": "literal"
            }
          },
          "additionalProperties": false,
          "required": [
            "kind",
            "value"
          ]
        },
        {
          "type": "object",
          "properties": {
            "address": {
              "$ref": "#/$defs/Address"
            },
            "path": {
              "type": "array",
              "items": {
                "type": "string"
              }
            },
            "kind": {
              "type": "string",
              "const": "resource_attr"
            }
          },
          "additionalProperties": false,
          "required": [
            "kind",
            "address",
            "path"
          ]
        },
        {
          "type": "object",
          "properties": {
            "address": {
              "$ref": "#/$defs/Address"
            },
            "path": {
              "type": "array",
              "items": {
                "type": "string"
              }
            },
            "kind": {
              "type": "string",
              "const": "data_source_attr"
            }
          },
          "additionalProperties": false,
          "required": [
            "kind",
            "address",
            "path"
          ]
        },
        {
          "type": "object",
          "properties": {
            "items": {
              "type": "array",
              "items": {
                "$ref": "#/$defs/Expr"
              }
            },
            "kind": {
              "type": "string",
              "const": "array"
            }
          },
          "additionalProperties": false,
          "required": [
            "kind",
            "items"
          ]
        },
        {
          "type": "object",
          "properties": {
            "fields": {
              "type": "object",
              "additionalProperties": {
                "$ref": "#/$defs/Expr"
              }
            },
            "kind": {
              "type": "string",
              "const": "object"
            }
          },
          "additionalProperties": false,
          "required": [
            "kind",
            "fields"
          ]
        },
        {
          "type": "object",
          "properties": {
            "collection": {
              "$ref": "#/$defs/Expr"
            },
            "key": {
              "$ref": "#/$defs/Expr"
            },
            "kind": {
              "type": "string",
              "const": "index"
            }
          },
          "additionalProperties": false,
          "required": [
            "kind",
            "collection",
            "key"
          ]
        },
        {
          "description": "The attribute `name` of a computed value, `of.name`: an element of a nested block\n(`x.network_interface[1].network_ip`), a splat, or any other expression that is not a\nplain reference (those carry attributes in their `path`).",
          "type": "object",
          "properties": {
            "of": {
              "$ref": "#/$defs/Expr"
            },
            "name": {
              "type": "string"
            },
            "kind": {
              "type": "string",
              "const": "attribute"
            }
          },
          "additionalProperties": false,
          "required": [
            "kind",
            "of",
            "name"
          ]
        },
        {
          "description": "The full splat `of[*]`.",
          "type": "object",
          "properties": {
            "of": {
              "$ref": "#/$defs/Expr"
            },
            "kind": {
              "type": "string",
              "const": "splat"
            }
          },
          "additionalProperties": false,
          "required": [
            "kind",
            "of"
          ]
        },
        {
          "type": "object",
          "properties": {
            "condition": {
              "$ref": "#/$defs/Expr"
            },
            "when_true": {
              "$ref": "#/$defs/Expr"
            },
            "when_false": {
              "$ref": "#/$defs/Expr"
            },
            "kind": {
              "type": "string",
              "const": "conditional"
            }
          },
          "additionalProperties": false,
          "required": [
            "kind",
            "condition",
            "when_true",
            "when_false"
          ]
        },
        {
          "type": "object",
          "properties": {
            "name": {
              "type": "string"
            },
            "args": {
              "type": "array",
              "items": {
                "$ref": "#/$defs/Expr"
              }
            },
            "kind": {
              "type": "string",
              "const": "function"
            }
          },
          "additionalProperties": false,
          "required": [
            "kind",
            "name",
            "args"
          ]
        },
        {
          "type": "object",
          "properties": {
            "parts": {
              "type": "array",
              "items": {
                "$ref": "#/$defs/TemplatePart"
              }
            },
            "kind": {
              "type": "string",
              "const": "template"
            }
          },
          "additionalProperties": false,
          "required": [
            "kind",
            "parts"
          ]
        },
        {
          "type": "object",
          "properties": {
            "name": {
              "type": "string"
            },
            "kind": {
              "type": "string",
              "const": "secret_env"
            }
          },
          "additionalProperties": false,
          "required": [
            "kind",
            "name"
          ]
        },
        {
          "type": "object",
          "properties": {
            "expression": {
              "type": "string"
            },
            "kind": {
              "type": "string",
              "const": "unsafe_raw"
            }
          },
          "additionalProperties": false,
          "required": [
            "kind",
            "expression"
          ]
        }
      ]
    },
    "Address": {
      "type": "string",
      "pattern": "^(data\\.)?[A-Za-z_][A-Za-z0-9_-]*\\.[A-Za-z_][A-Za-z0-9_-]*$"
    },
    "TemplatePart": {
      "oneOf": [
        {
          "type": "object",
          "properties": {
            "value": {
              "type": "string"
            },
            "kind": {
              "type": "string",
              "const": "literal"
            }
          },
          "additionalProperties": false,
          "required": [
            "kind",
            "value"
          ]
        },
        {
          "type": "object",
          "properties": {
            "expression": {
              "$ref": "#/$defs/Expr"
            },
            "kind": {
              "type": "string",
              "const": "interpolation"
            }
          },
          "additionalProperties": false,
          "required": [
            "kind",
            "expression"
          ]
        }
      ]
    },
    "ResourceSpec": {
      "type": "object",
      "properties": {
        "type": {
          "type": "string"
        },
        "name": {
          "type": "string"
        },
        "arguments": {
          "type": "object",
          "additionalProperties": {
            "$ref": "#/$defs/Expr"
          },
          "default": {}
        },
        "depends_on": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/Address"
          },
          "default": []
        },
        "provider": {
          "type": [
            "string",
            "null"
          ]
        },
        "lifecycle": {
          "anyOf": [
            {
              "$ref": "#/$defs/Lifecycle"
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "additionalProperties": false,
      "required": [
        "type",
        "name"
      ]
    },
    "Lifecycle": {
      "type": "object",
      "properties": {
        "create_before_destroy": {
          "type": "boolean"
        },
        "prevent_destroy": {
          "type": "boolean"
        },
        "ignore_changes": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "replace_triggered_by": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/Address"
          }
        }
      },
      "additionalProperties": false
    },
    "DataSourceSpec": {
      "type": "object",
      "properties": {
        "type": {
          "type": "string"
        },
        "name": {
          "type": "string"
        },
        "arguments": {
          "type": "object",
          "additionalProperties": {
            "$ref": "#/$defs/Expr"
          },
          "default": {}
        },
        "depends_on": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/Address"
          },
          "default": []
        },
        "provider": {
          "type": [
            "string",
            "null"
          ]
        }
      },
      "additionalProperties": false,
      "required": [
        "type",
        "name"
      ]
    },
    "OutputSpec": {
      "type": "object",
      "properties": {
        "value": {
          "$ref": "#/$defs/Expr"
        },
        "sensitive": {
          "type": "boolean"
        },
        "description": {
          "type": [
            "string",
            "null"
          ]
        }
      },
      "additionalProperties": false,
      "required": [
        "value"
      ]
    },
    "MoveSpec": {
      "type": "object",
      "properties": {
        "from": {
          "$ref": "#/$defs/Address"
        },
        "to": {
          "$ref": "#/$defs/Address"
        }
      },
      "additionalProperties": false,
      "required": [
        "from",
        "to"
      ]
    },
    "ImportSpec": {
      "description": "Adopt the existing object identified by `id` (in the provider's import-id syntax) as the\nmanaged resource `to`.",
      "type": "object",
      "properties": {
        "to": {
          "$ref": "#/$defs/Address"
        },
        "id": {
          "type": "string"
        }
      },
      "additionalProperties": false,
      "required": [
        "to",
        "id"
      ]
    }
  }
}
