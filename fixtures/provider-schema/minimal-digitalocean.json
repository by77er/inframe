{
  "format_version": "1.0",
  "provider_schemas": {
    "registry.opentofu.org/digitalocean/digitalocean": {
      "provider": {
        "version": 0,
        "block": {
          "attributes": {
            "token": {
              "type": "string",
              "optional": true,
              "sensitive": true,
              "description": "DigitalOcean API token. Prefer DIGITALOCEAN_TOKEN."
            }
          }
        }
      },
      "resource_schemas": {
        "digitalocean_tag": {
          "version": 0,
          "block": {
            "attributes": {
              "id": { "type": "string", "computed": true },
              "name": { "type": "string", "required": true },
              "total_resource_count": { "type": "number", "computed": true }
            }
          }
        }
      },
      "data_source_schemas": {}
    }
  }
}

