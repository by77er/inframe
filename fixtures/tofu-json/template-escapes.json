{
  "output": {
    "conditional": {
      "value": "${true ? \"$${yes}\" : \"$${no}\"}"
    },
    "expression_list": {
      "value": [
        "$${1+2}",
        "%%{ if true }rewritten%%{ endif }"
      ]
    },
    "expression_object": {
      "value": {
        "$${key}": "$${value}"
      }
    },
    "literal_inside_function": {
      "value": "${tolist([\"$${1+2}\", \"%%{ if true }x%%{ endif }\"])}"
    },
    "literal_list": {
      "value": [
        "$${1+2}",
        "%%{ if true }rewritten%%{ endif }"
      ]
    },
    "literal_object": {
      "value": {
        "$${1+2}": "$${3+4}",
        "%%{ if true }key%%{ endif }": [
          "$${5}"
        ]
      }
    },
    "object_keys_inside_function": {
      "value": "${keys({ \"$${key}\" = \"value\" })}"
    },
    "scalar": {
      "value": "$${1+2}"
    },
    "template": {
      "value": "$${not} ${\"%%{ x }\"}"
    }
  }
}
